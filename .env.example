# ==============================================================================
# SIGCOI - Sistema de Gestão de Coleções Osteológicas Identificadas
# Arquivo de Exemplo de Variáveis de Ambiente (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Inteligência Artificial e Roteamento
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Opcional / Recomendado para recursos de IA (assistente pericial e condutor por voz).
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública onde a aplicação está hospedada (ex: https://meulab-osteo.onrender.com).
# Usada para links auto-referenciais, callbacks e rotas seguras.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. Banco de Dados e Sessão (Obrigatórios para Produção)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL para persistência (conjuntos, formulários A.1/A.2, assinaturas SHA-256,
# custódia, registro de alterações, fotos de montagem e inventário).
# - Produção em Nuvem: Connection string "pooled" do Neon (console.neon.tech) ou Postgres de sua faculdade.
# - Desenvolvimento local / Docker Compose: vide docker-compose.yml.
DATABASE_URL="postgresql://sgcccco_app:CHANGE_ME@localhost:5432/sgcccco"

# SESSION_SECRET: Assina o cookie de sessão do login com criptografia httpOnly.
# Gere um segredo aleatório e seguro: `openssl rand -hex 32`
SESSION_SECRET="CHANGE_ME"

# ADMIN_BOOTSTRAP_SECRET: Opcional — só necessário ao migrar bancos pré-existentes.
# Gere com `openssl rand -hex 32` caso vá realizar migração de contas sem senha.
ADMIN_BOOTSTRAP_SECRET="CHANGE_ME"

# ------------------------------------------------------------------------------
# 3. Parametrização Multi-Institucional para Universidades Parceiras
# ------------------------------------------------------------------------------
# As variáveis abaixo permitem customizar a identidade visual, sigla e prefixos
# do acervo para sua universidade sem encostar em nenhuma linha de código.
# Caso não sejam informadas, o sistema adota os valores canônicos da pesquisa.

# Nome oficial por extenso da universidade ou faculdade gestora
VITE_INSTITUTION_NAME="Universidade de São Paulo - IB/USP"

# Sigla ou acrônimo da instituição/laboratório exibido nos cabeçalhos e crachás
VITE_INSTITUTION_ACRONYM="LAF-USP"

# Nome do software (Padrão: SIGCOI)
VITE_SYSTEM_NAME="SIGCOI"

# Título resumido para cabeçalhos móveis e cards
VITE_SYSTEM_SHORT_TITLE="Coleções Osteológicas"

# Subtítulo descritivo da plataforma
VITE_SYSTEM_SUBTITLE="Sistema de Gestão de Coleções Osteológicas Identificadas"

# Prefixo padrão para códigos de acervo e caixas (ex.: COI, USP-OSTEO, UFMG-COI)
VITE_COLLECTION_PREFIX="COI"

# Rótulo de versão/ambiente exibido no topo (ex.: ALFA, PROD, PILOTO)
VITE_VERSION_TAG="ALFA"

# URL de logotipo customizado da sua universidade (ex.: /logo-usp.png ou URL HTTPS pública)
# VITE_LOGO_URL="https://minhauniversidade.edu.br/assets/logo.png"

# E-mail institucional do Curador / Laboratório responsável para suporte e solicitações de acesso
VITE_CURATOR_CONTACT_EMAIL="curadoria.osteologia@usp.br"

# Idioma padrão da interface (pt-BR, en-US, es-ES)
VITE_DEFAULT_LANGUAGE="pt-BR"
